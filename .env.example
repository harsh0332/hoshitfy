# Copy to .env.local for local dev. Set the same variables in Vercel → Project → Settings → Environment Variables.

# Lead delivery (REQUIRED in production). Every form submission is POSTed here as JSON.
# If empty, leads are only written to the server log (and .leads/leads.ndjson locally).
N8N_LEAD_WEBHOOK_URL=""

# WhatsApp number in international format, digits only (e.g. 9198XXXXXXXX or 97150XXXXXXX).
# If empty, every WhatsApp button and link is hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Cal.com booking link, "username/event" (qualified leads book here)
NEXT_PUBLIC_CALCOM_LINK="hosteditify/content-audit"

# Meta Pixel (browser) + Conversions API (server). Both are skipped when empty.
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=""

# Contact + social links
NEXT_PUBLIC_CONTACT_EMAIL="contact@hosteditify.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/hosteditify"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/hosteditify"
